<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleDisplayName</key>
	<string>Quietform</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Quietform</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Development-only: the connected iPhone downloads the test IPA from this Mac. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Quietform 需要访问本地网络，以连接同一网络中的资源服务。</string>
	<key>AppBoxGuestURL</key>
	<string>$(APPBOX_GUEST_URL)</string>
	<key>AppBoxCatalogBaseURL</key>
	<string>$(APPBOX_CATALOG_BASE_URL)</string>
	<key>AppBoxClientAESKey</key>
	<string>$(APPBOX_CLIENT_AES_KEY)</string>
	<key>AppBoxAssetAESKey</key>
	<string>$(APPBOX_ASSET_AES_KEY)</string>
	<key>AppBoxAssetAESIV</key>
	<string>$(APPBOX_ASSET_AES_IV)</string>
	<key>AppBoxPornhubGuestURL</key>
	<string>$(APPBOX_PORNHUB_GUEST_URL)</string>
	<key>AppBoxPlayBoxGuestURL</key>
	<string>$(APPBOX_PLAYBOX_GUEST_URL)</string>
	<key>AppBoxDYZBGQGuestURL</key>
	<string>$(APPBOX_DYZB_GQ_GUEST_URL)</string>
	<key>AppBoxDYZBTFGuestURL</key>
	<string>$(APPBOX_DYZB_TF_GUEST_URL)</string>
	<key>AppBoxChungongGuestURL</key>
	<string>$(APPBOX_CHUNGONG_GUEST_URL)</string>
	<key>AppBoxIGXiongmaoGuestURL</key>
	<string>$(APPBOX_IG_XIONGMAO_GUEST_URL)</string>
	<key>AppBoxTianya348GuestURL</key>
	<string>$(APPBOX_TIANYA_348_GUEST_URL)</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	
	<!-- AppBox only owns its own relaunch scheme. The original Flutter app keeps tianya://. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>appbox.guest.relaunch</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>appbox</string>
			</array>
		</dict>
	</array>

	<key>NSNetworkExtensionUsageDescription</key>
    <string>Quietform 需要 VPN 权限来保护您的网络安全和隐私，并加密网络连接。</string>
    
    <!-- 相册访问权限 -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Quietform 需要访问您的相册，以选择和保存图片、发布内容及设置头像。</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Quietform 需要写入您的相册，以保存图片和视频。</string>
    
    <!-- 相机权限（二维码扫描、头像拍摄等） -->
    <key>NSCameraUsageDescription</key>
    <string>Quietform 需要访问您的相机，以扫描二维码、拍摄照片、发布内容及设置头像。</string>
    
    <!-- 麦克风权限（用于聊天室语音直播） -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Quietform 需要访问您的麦克风，以使用语音和录音功能。</string>
    
    <!-- 定位权限（VPN 网络优化 / 实时位置共享） -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Quietform 需要在使用期间获取您的位置，以共享位置并优化网络连接。</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Quietform 仅在您主动共享实时位置时持续获取位置；您可随时在系统设置中关闭。</string>
</dict>
</plist>
