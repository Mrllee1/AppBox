{
  "name": "appbox-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Tianya AppBox API and admin console",
  "scripts": {
    "dev:api": "tsx api/src/main.ts",
    "dev:admin": "next dev admin -H 127.0.0.1 -p 39111",
    "build": "npm run build:api && npm run build:admin",
    "build:api": "tsc -p api/tsconfig.json",
    "build:admin": "next build admin",
    "start:api": "node dist/api/main.js",
    "start:admin": "next start admin -H 127.0.0.1 -p 39111",
    "test:api": "node --test tests/api.integration.mjs",
    "test": "npm run test:api && npm run build"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.5",
    "@ant-design/icons": "^6.0.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "antd": "^5.27.0",
    "next": "^16.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
