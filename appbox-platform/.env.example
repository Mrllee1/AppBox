APPBOX_API_PORT=39110
APPBOX_DATA_FILE=./data/appbox-store.json
APPBOX_ASSET_DIR=./data/assets
APPBOX_ALLOWED_ORIGINS=http://127.0.0.1:39111,http://localhost:39111
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:39110
NEXT_TELEMETRY_DISABLED=1
APPBOX_ADMIN_USERNAME=admin
APPBOX_ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-salt$replace-with-generated-hash
APPBOX_ADMIN_SESSION_SECRET=replace-with-strong-random-secret
APPBOX_ADMIN_SESSION_TTL_SECONDS=28800
APPBOX_CREDENTIAL_AES_KEY=replace-with-32-byte-base64-key-for-admin-saved-secrets
APPBOX_CLIENT_AES_KID=v1
APPBOX_CLIENT_AES_KEY=replace-with-32-byte-base64-key
APPBOX_CLIENT_ENCRYPTION_REQUIRED=true
APPBOX_ASSET_AES_KEY=replace-with-32-byte-base64-key
APPBOX_ASSET_AES_IV=replace-with-16-byte-base64-iv
